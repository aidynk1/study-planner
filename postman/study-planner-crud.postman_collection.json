{
  "info": {
    "_postman_id": "82d8734c-9ef7-4e2d-ad6a-202611060001",
    "name": "Study Planner API - Task CRUD",
    "description": "Проверка CRUD учебных задач. Запустите FastAPI на localhost:8000 и выполните запросы по порядку.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET - list tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET list returns 200 and a JSON array', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman CRUD check\",\n  \"description\": \"Created by the Postman collection\",\n  \"due_date\": \"2026-11-20\",\n  \"status\": \"planned\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('POST creates a task', function () {",
              "  pm.response.to.have.status(201);",
              "  const task = pm.response.json();",
              "  pm.expect(task.id).to.be.a('number');",
              "  pm.expect(task.title).to.eql('Postman CRUD check');",
              "  pm.collectionVariables.set('taskId', task.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - read created task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET by id reads the persisted task', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('taskId')));",
              "  pm.expect(pm.response.json().title).to.eql('Postman CRUD check');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - replace task",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman CRUD updated\",\n  \"description\": \"PUT replaced the stored fields\",\n  \"due_date\": \"2026-11-25\",\n  \"status\": \"in_progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PUT replaces the task by id', function () {",
              "  pm.response.to.have.status(200);",
              "  const task = pm.response.json();",
              "  pm.expect(task.title).to.eql('Postman CRUD updated');",
              "  pm.expect(task.description).to.eql('PUT replaced the stored fields');",
              "  pm.expect(task.status).to.eql('in_progress');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - confirm PUT persisted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET confirms the PUT values were stored', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().title).to.eql('Postman CRUD updated');",
              "  pm.expect(pm.response.json().status).to.eql('in_progress');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - remove task by id",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('DELETE removes the task by id', function () {",
              "  pm.response.to.have.status(204);",
              "  pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - confirm DELETE persisted",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('GET confirms the deleted task is absent', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
