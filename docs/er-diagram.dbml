
// Итерация 1: docs/er-diagram-v1.dbml — сущности и связь 1:N.
// Итерация 2: docs/er-diagram-v2.dbml — поля, дедлайн и статус.
// Итерация 3: docs/er-diagram-v3.dbml — updated_at, индексы и каскадное удаление.
Table users {
  id integer [pk, increment]
  name varchar(100) [not null]
  email varchar(254) [not null, unique]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table tasks {
  id integer [pk, increment]
  user_id integer [not null]
  title varchar(200) [not null]
  description text [not null, default: '']
  due_date date
  status varchar(20) [not null, default: 'planned', note: 'planned | in_progress | done']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  checks {
    `status IN ('planned', 'in_progress', 'done')` [name: 'ck_tasks_status']
  }

  indexes {
    (user_id, status) [name: 'ix_tasks_user_status']
    due_date [name: 'ix_tasks_due_date']
  }
}

Ref: tasks.user_id > users.id [delete: cascade]
